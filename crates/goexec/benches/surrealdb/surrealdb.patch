new file mode 100644
index 0000000..023c13b
--- /dev/null
+++ b/surrealdb/core/src/runtime.rs
@@ -0,0 +1,63 @@
+//! Experimental native embedded runtime selection. Synchronization primitives
+//! remain executor independent; task and timer entry points are selected here.
+
+#[cfg(all(feature = "runtime-goexec", target_family = "wasm"))]
+compile_error!("runtime-goexec supports native embedded engines only");
+
+#[cfg(feature = "runtime-goexec")]
+pub use goexec::{spawn, time};
+#[cfg(not(feature = "runtime-goexec"))]
+pub use tokio::{spawn, time};
+
+pub async fn consume_budget() {
+	#[cfg(feature = "runtime-goexec")]
+	goexec::consume_budget().await;
+	#[cfg(not(feature = "runtime-goexec"))]
+	if tokio::runtime::Handle::try_current().is_ok() {
+		tokio::task::consume_budget().await;
+	}
+}
+
+#[cfg(not(feature = "runtime-goexec"))]
+pub use tokio::task;
+
+#[cfg(feature = "runtime-goexec")]
+pub mod task {
+	pub use goexec::{JoinError, JoinHandle, yield_now};
+
+	/// Preserve a separate CPU pool for synchronous sorting and mixed external
+	/// sorting. Never label CPU work as a goexec blocking syscall.
+	pub fn spawn_blocking<F, R>(f: F) -> JoinHandle<R>
+	where
+		F: FnOnce() -> R + Send + 'static,
+		R: Send + 'static,
+	{
+		let (send, recv) = futures::channel::oneshot::channel();
+		rayon::spawn(move || {
+			let result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(f));
+			let _ = send.send(result);
+		});
+		goexec::spawn(async move {
+			match recv.await.expect("blocking producer dropped") {
+				Ok(value) => value,
+				Err(panic) => std::panic::resume_unwind(panic),
+			}
+		})
+	}
+}
+
+/// Spawn an independently progressing owned file-I/O operation.
+pub fn spawn_io<F, R>(f: F) -> task::JoinHandle<R>
+where
+	F: FnOnce() -> R + Send + 'static,
+	R: Send + 'static,
+{
+	#[cfg(feature = "runtime-goexec")]
+	{
+		goexec::spawn(async move { goexec::blocking(f) })
+	}
+	#[cfg(not(feature = "runtime-goexec"))]
+	{
+		tokio::task::spawn_blocking(f)
+	}
+}
