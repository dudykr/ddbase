+
+#[cfg(feature = "runtime-goexec")]
+mod goexec_tasks {
+	use futures::StreamExt;
+	use futures::stream::FuturesUnordered;
+	pub struct JoinSet<T> {
+		tasks: FuturesUnordered<goexec::JoinHandle<T>>,
+	}
+	impl<T> Default for JoinSet<T> {
+		fn default() -> Self {
+			Self {
+				tasks: FuturesUnordered::new(),
+			}
+		}
+	}
+	impl<T: Send + 'static> JoinSet<T> {
+		pub fn spawn<F: std::future::Future<Output = T> + Send + 'static>(&mut self, future: F) {
+			self.tasks.push(goexec::spawn(future));
+		}
+		pub fn spawn_on<F: std::future::Future<Output = T> + Send + 'static>(
+			&mut self,
+			future: F,
+			handle: goexec::Handle,
+		) {
+			self.tasks.push(handle.spawn(future));
+		}
+		pub async fn join_next(&mut self) -> Option<Result<T, goexec::JoinError>> {
+			self.tasks.next().await
+		}
+	}
+	impl<T> Drop for JoinSet<T> {
+		fn drop(&mut self) {
+			for task in self.tasks.iter() {
+				task.abort();
+			}
+		}
+	}
+}
