@@ -0,0 +1,476 @@
+#![recursion_limit = "512"]
+use std::collections::HashMap;
+use std::hint::black_box;
+use std::sync::{Arc, OnceLock};
+use std::time::{Duration, Instant};
+
+use anyhow::{Context, Result, ensure};
+use hdrhistogram::Histogram;
+use serde_json::json;
+use surrealdb::Surreal;
+use surrealdb::engine::local::Db;
+use surrealdb_core::cnf::ConfigMap;
+use surrealdb_core::dbs::{Capabilities, Session};
+use surrealdb_core::kvs::Datastore;
+use surrealdb_core::options::EngineOptions;
+use surrealdb_core::runtime;
+use surrealdb_types::Value;
+use tokio_util::sync::CancellationToken;
+
+#[cfg(feature = "runtime-goexec")]
+static HANDLE: OnceLock<goexec::Handle> = OnceLock::new();
+
+#[derive(Clone)]
+struct Client {
+	ds: Arc<Datastore>,
+	sdk: Option<Surreal<Db>>,
+	cancel: CancellationToken,
+}
+
+impl Client {
+	async fn open(args: &Args) -> Result<Self> {
+		#[cfg(feature = "runtime-goexec")]
+		ensure!(
+			tokio::runtime::Handle::try_current().is_err(),
+			"a Tokio runtime must not exist in goexec runs"
+		);
+		let config = ConfigMap::from_env()
+			.with_key_value("datastore_sync", "every")
+			.with_key_value("rocksdb_thread_count", args.parallelism.to_string());
+		let ds = Arc::new(
+			Datastore::builder()
+				.with_config(config)
+				.with_runtime_worker_threads(args.parallelism)
+				.with_capabilities(Capabilities::all())
+				.build_with_path(&args.endpoint())
+				.await?,
+		);
+		if args.backend == "rocksdb" {
+			ensure!(
+				ds.collect_u64_metric("rocksdb.inline_blocking_cap")
+					== Some(args.parallelism.saturating_sub(2) as u64),
+				"effective RocksDB worker cap mismatch"
+			);
+		}
+		ds.check_version().await?;
+		ds.bootstrap().await?;
+		let cancel = CancellationToken::new();
+		let sdk = if args.access == "sdk" {
+			Some(
+				Surreal::unstable_from_datastore(
+					cancel.clone(),
+					ds.clone(),
+					None,
+					EngineOptions::default(),
+				)
+				.await?,
+			)
+		} else {
+			None
+		};
+		let client = Self {
+			ds,
+			sdk,
+			cancel,
+		};
+		if let Some(db) = &client.sdk {
+			db.query("DEFINE NAMESPACE IF NOT EXISTS bench").await?.check()?;
+			db.use_ns("bench").await?;
+			db.query("DEFINE DATABASE IF NOT EXISTS bench").await?.check()?;
+			db.use_db("bench").await?;
+		} else {
+			for (query, session) in [
+				("DEFINE NAMESPACE IF NOT EXISTS bench", Session::owner()),
+				("DEFINE DATABASE IF NOT EXISTS bench", Session::owner().with_ns("bench")),
+			] {
+				for response in client.ds.execute(query, &session, None).await? {
+					response.output()?;
+				}
+			}
+		}
+		Ok(client)
+	}
+
+	async fn query(&self, sql: &str) -> Result<Vec<Value>> {
+		if let Some(db) = &self.sdk {
+			let mut response = db.query(sql).await?.check()?;
+			(0..response.num_statements()).map(|i| response.take(i).map_err(Into::into)).collect()
+		} else {
+			let session = Session::owner().with_ns("bench").with_db("bench");
+			self.ds
+				.execute(sql, &session, None)
+				.await?
+				.into_iter()
+				.map(|r| r.output().map_err(Into::into))
+				.collect()
+		}
+	}
+
+	async fn close(self) -> Result<()> {
+		let Self {
+			ds,
+			sdk,
+			cancel,
+		} = self;
+		if sdk.is_some() {
+			cancel.cancel();
+			drop(sdk);
+			// The SDK router resolves background tasks and shuts the datastore
+			// down before releasing its final datastore reference.
+			runtime::time::timeout(Duration::from_secs(30), async {
+				while Arc::strong_count(&ds) > 1 {
+					runtime::time::sleep(Duration::from_millis(1)).await;
+				}
+			})
+			.await
+			.context("SDK router/background tasks did not terminate")?;
+		} else {
+			ds.shutdown().await?;
+		}
+		drop(ds);
+		Ok(())
+	}
+}
+
+#[derive(Clone)]
+struct Args {
+	backend: String,
+	path: String,
+	access: String,
+	workload: String,
+	parallelism: usize,
+	lanes: usize,
+	records: usize,
+	warmup: f64,
+	seconds: f64,
+	seed: u64,
+	verify: bool,
+}
+impl Args {
+	fn parse() -> Result<Self> {
+		let mut map = HashMap::new();
+		let mut args = std::env::args().skip(1);
+		while let Some(key) = args.next() {
+			if key == "--verify" {
+				map.insert(key, "true".into());
+			} else {
+				map.insert(key, args.next().context("missing CLI argument value")?);
+			}
+		}
+		let get = |key: &str, default: &str| map.get(key).cloned().unwrap_or(default.into());
+		let this = Self {
+			backend: get("--backend", "memory"),
+			path: get("--path", "runtime-bench.db"),
+			access: get("--access", "sdk"),
+			workload: get("--workload", "read"),
+			parallelism: get("--parallelism", "4").parse()?,
+			lanes: get("--lanes", "16").parse()?,
+			records: get("--records", "100000").parse()?,
+			warmup: get("--warmup", "3").parse()?,
+			seconds: get("--seconds", "10").parse()?,
+			seed: get("--seed", "20260917").parse()?,
+			verify: map.contains_key("--verify"),
+		};
+		ensure!(
+			this.parallelism > 0
+				&& this.lanes > 0
+				&& this.records >= this.lanes
+				&& this.records >= 64,
+			"invalid concurrency/record count"
+		);
+		ensure!(matches!(this.backend.as_str(), "memory" | "rocksdb"), "unknown backend");
+		ensure!(matches!(this.access.as_str(), "sdk" | "core"), "unknown access path");
+		ensure!(
+			matches!(this.workload.as_str(), "read" | "create" | "update" | "mixed" | "range"),
+			"unknown workload"
+		);
+		Ok(this)
+	}
+	fn endpoint(&self) -> String {
+		if self.backend == "memory" {
+			"memory".into()
+		} else {
+			format!("rocksdb://{}", self.path)
+		}
+	}
+}
+
+async fn seed(client: &Client, records: usize, seed: u64) -> Result<()> {
+	client.query("DEFINE TABLE bench SCHEMALESS; DEFINE INDEX by_n ON bench FIELDS n;").await?;
+	for start in (0..records).step_by(1000) {
+		let mut sql = "INSERT INTO bench [".to_string();
+		for id in start..(start + 1000).min(records) {
+			if id != start {
+				sql.push(',');
+			}
+			sql.push_str(&format!(
+				"{{id:bench:{id},n:{id},payload:'{}',version:0}}",
+				payload(id as u64, seed)
+			));
+		}
+		sql.push_str("] RETURN NONE;");
+		client.query(&sql).await.context("seed records")?;
+	}
+	let count = client.query("SELECT count() AS total FROM bench GROUP ALL").await?;
+	ensure!(
+		count.last().unwrap().get(0).get("total").clone().into_t::<u64>()? == records as u64,
+		"seed row count mismatch: {count:?}"
+	);
+	Ok(())
+}
+
+fn xorshift(state: &mut u64) -> u64 {
+	*state ^= *state << 13;
+	*state ^= *state >> 7;
+	*state ^= *state << 17;
+	*state
+}
+
+fn payload(id: u64, seed: u64) -> String {
+	const ALPHABET: &[u8] = b"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
+	let mut state = seed.wrapping_add(id.wrapping_mul(0x9e3779b97f4a7c15)).max(1);
+	(0..960)
+		.map(|_| ALPHABET[(xorshift(&mut state) % ALPHABET.len() as u64) as usize] as char)
+		.collect()
+}
+
+fn query_for(args: &Args, lane: usize, iteration: u64, random: u64, warm: bool) -> String {
+	let keys = (args.records - lane + args.lanes - 1) / args.lanes;
+	let id = lane as u64 + (random % keys as u64) * args.lanes as u64;
+	let workload = if args.workload == "mixed" {
+		if random % 5 == 0 {
+			"update"
+		} else {
+			"read"
+		}
+	} else {
+		&args.workload
+	};
+	match workload {
+		"read" => format!("SELECT * FROM bench:{id}"),
+		"update" => format!("UPDATE bench:{id} SET version += 1 RETURN NONE"),
+		"create" => {
+			let id = args.records as u64
+				+ lane as u64 * 1_000_000_000
+				+ iteration + if warm {
+				1_000_000_000_000
+			} else {
+				0
+			};
+			format!(
+				"CREATE bench:{id} SET n={id},payload='{}',version=0 RETURN NONE",
+				payload(id, args.seed)
+			)
+		}
+		"range" => {
+			let start = random % (args.records as u64 - 32);
+			format!(
+				"SELECT id,n FROM bench WHERE n >= {start} AND n < {} ORDER BY n LIMIT 32",
+				start + 32
+			)
+		}
+		_ => unreachable!(),
+	}
+}
+
+async fn phase(client: &Client, args: &Args, warm: bool) -> Result<(u64, Histogram<u64>, f64)> {
+	let duration = Duration::from_secs_f64(if warm {
+		args.warmup
+	} else {
+		args.seconds
+	});
+	let barrier = Arc::new(tokio::sync::Barrier::new(args.lanes + 1));
+	let timing = Arc::new(OnceLock::new());
+	let mut tasks = Vec::new();
+	for lane in 0..args.lanes {
+		let client = client.clone();
+		let args = args.clone();
+		let barrier = barrier.clone();
+		let timing: Arc<OnceLock<Instant>> = timing.clone();
+		tasks.push(runtime::spawn(async move {
+			let mut histogram = Histogram::<u64>::new(3)?;
+			let mut random = args.seed.wrapping_add(31 * lane as u64 + 1);
+			let mut ops = 0u64;
+			barrier.wait().await;
+			let deadline = *timing.get().unwrap() + duration;
+			while Instant::now() < deadline {
+				let sql = query_for(&args, lane, ops, xorshift(&mut random), warm);
+				let start = Instant::now();
+				let result = client.query(&sql).await?;
+				let nanos = start.elapsed().as_nanos().min(u64::MAX as u128) as u64;
+				if !warm {
+					histogram.record(nanos.max(1))?;
+				}
+				if args.workload == "read" || args.workload == "range" {
+					ensure!(
+						!result.last().context("no statement result")?.is_empty(),
+						"unexpected empty read"
+					);
+				}
+				black_box(result);
+				ops += 1;
+				runtime::consume_budget().await;
+			}
+			Ok::<_, anyhow::Error>((ops, histogram))
+		}));
+	}
+	let start = Instant::now();
+	timing.set(start).unwrap();
+	barrier.wait().await;
+	let mut total = 0;
+	let mut histogram = Histogram::<u64>::new(3)?;
+	for task in tasks {
+		let (ops, samples) = task.await??;
+		total += ops;
+		histogram.add(&samples)?;
+	}
+	Ok((total, histogram, start.elapsed().as_secs_f64()))
+}
+
+async fn verify(args: &Args) -> Result<serde_json::Value> {
+	let client = Client::open(args).await?;
+	client.query("DEFINE TABLE checks SCHEMALESS; DEFINE INDEX by_n ON checks FIELDS n;").await?;
+	client.query("CREATE checks:one SET n=1; CREATE checks:two SET n=2;").await?;
+	let values = client.query("SELECT VALUE n FROM checks ORDER BY n").await?;
+	ensure!(
+		values[0].get(0).clone().into_t::<u64>()? == 1
+			&& values[0].get(1).clone().into_t::<u64>()? == 2,
+		"create/read mismatch"
+	);
+	client.query("UPDATE checks:one SET n=3;").await?;
+	// An explicitly cancelled transaction reports an error for its statements.
+	let _ =
+		client.query("BEGIN TRANSACTION; UPDATE checks:one SET n=99; CANCEL TRANSACTION;").await;
+	let after = client.query("SELECT VALUE n FROM checks:one").await?;
+	ensure!(after[0].get(0).clone().into_t::<u64>()? == 3, "rollback lost original value");
+	let indexed =
+		client.query("SELECT VALUE n FROM checks WITH INDEX by_n WHERE n >= 2 ORDER BY n").await?;
+	ensure!(
+		indexed[0].get(0).clone().into_t::<u64>()? == 2
+			&& indexed[0].get(1).clone().into_t::<u64>()? == 3,
+		"index query mismatch"
+	);
+	client.query("DELETE checks:two;").await?;
+	ensure!(client.query("SELECT * FROM checks:two").await?[0].is_empty(), "delete failed");
+	client.query("SLEEP 2ms;").await?;
+	let timeout = client.query("SELECT * FROM checks WHERE sleep(1s) = NONE TIMEOUT 5ms;").await;
+	let error = timeout.expect_err("query timeout unexpectedly succeeded");
+	ensure!(
+		error.to_string().contains("exceeded the timeout"),
+		"unexpected timeout error: {error:#}"
+	);
+	let cancellation = surrealdb_core::ctx::CancelHandle::new();
+	let request_cancel = cancellation.clone();
+	let datastore = client.ds.clone();
+	let request = runtime::spawn(async move {
+		datastore
+			.execute_with_cancel(
+				"SLEEP 60s; CREATE checks:cancelled SET n=999;",
+				&Session::owner().with_ns("bench").with_db("bench"),
+				None,
+				request_cancel,
+			)
+			.await
+	});
+	runtime::time::sleep(Duration::from_millis(10)).await;
+	cancellation.trip();
+	let cancelled = runtime::time::timeout(Duration::from_secs(5), request).await??;
+	let cancellation_messages: Vec<String> = match cancelled {
+		Ok(responses) => {
+			responses.into_iter().filter_map(|r| r.output().err().map(|e| e.to_string())).collect()
+		}
+		Err(error) => vec![error.to_string()],
+	};
+	ensure!(
+		cancellation_messages.iter().any(|e| e.contains("cancel")),
+		"cancellation did not propagate: {cancellation_messages:?}"
+	);
+	ensure!(
+		client.query("SELECT * FROM checks:cancelled").await?[0].is_empty(),
+		"cancelled query performed a write"
+	);
+	// Let the normal SDK membership refresh interval fire at least once.
+	runtime::time::sleep(Duration::from_millis(3100)).await;
+	client.close().await?;
+	if args.backend == "rocksdb" {
+		let reopened = Client::open(args).await?;
+		let persisted = reopened.query("SELECT VALUE n FROM checks:one").await?;
+		ensure!(persisted[0].get(0).clone().into_t::<u64>()? == 3, "reopen lost committed data");
+		reopened.close().await?;
+	}
+	Ok(
+		json!({"kind":"verification", "passed":true, "backend":args.backend, "access":args.access, "parallelism":args.parallelism, "checks":["crud","rollback","index","sleep","query_timeout","external_cancellation","background_shutdown","reopen_if_rocksdb"]}),
+	)
+}
+
+fn handoffs() -> u64 {
+	#[cfg(feature = "runtime-goexec")]
+	{
+		HANDLE.get().unwrap().metrics().handoffs
+	}
+	#[cfg(not(feature = "runtime-goexec"))]
+	{
+		0
+	}
+}
+
+async fn run(args: Args) -> Result<serde_json::Value> {
+	if args.verify {
+		return verify(&args).await;
+	}
+	let init = Instant::now();
+	let client = Client::open(&args).await?;
+	seed(&client, args.records, args.seed).await?;
+	let setup_seconds = init.elapsed().as_secs_f64();
+	let (warm_ops, _, _) = phase(&client, &args, true).await?;
+	let before_handoffs = handoffs();
+	let before_granted =
+		client.ds.collect_u64_metric("rocksdb.inline_blocking_granted").unwrap_or(0);
+	let before_diverted =
+		client.ds.collect_u64_metric("rocksdb.inline_blocking_diverted").unwrap_or(0);
+	let (ops, histogram, seconds) = phase(&client, &args, false).await?;
+	let handoffs = handoffs() - before_handoffs;
+	let granted = client.ds.collect_u64_metric("rocksdb.inline_blocking_granted").unwrap_or(0)
+		- before_granted;
+	let diverted = client.ds.collect_u64_metric("rocksdb.inline_blocking_diverted").unwrap_or(0)
+		- before_diverted;
+	if args.workload == "create" {
+		let count = client.query("SELECT count() AS total FROM bench GROUP ALL").await?;
+		ensure!(
+			count[0].get(0).get("total").clone().into_t::<u64>()?
+				== args.records as u64 + warm_ops + ops,
+			"created row count mismatch"
+		);
+	}
+	client.close().await?;
+	Ok(
+		json!({"kind":"benchmark", "backend":args.backend,"access":args.access,"workload":args.workload,"parallelism":args.parallelism,"lanes":args.lanes,"records":args.records,"seed":args.seed,"setup_seconds":setup_seconds,"warmup_ops":warm_ops,"operations":ops,"seconds":seconds,"ops_per_second":ops as f64/seconds,"p50_ns":histogram.value_at_quantile(0.5),"p99_ns":histogram.value_at_quantile(0.99),"errors":0,"handoffs":handoffs,"rocksdb_granted":granted,"rocksdb_diverted":diverted}),
+	)
+}
+
+fn main() -> Result<()> {
+	let args = Args::parse()?;
+	rayon::ThreadPoolBuilder::new().num_threads(args.parallelism).build_global()?;
+	let parallelism = args.parallelism;
+	#[cfg(feature = "runtime-goexec")]
+	let report = {
+		let rt = goexec::Runtime::builder().parallelism(parallelism).max_threads(512).build()?;
+		HANDLE.set(rt.handle()).ok().unwrap();
+		let report = rt.block_on(async move { run(args).await });
+		ensure!(rt.shutdown_timeout(Duration::from_secs(30)), "goexec shutdown timed out");
+		report?
+	};
+	#[cfg(not(feature = "runtime-goexec"))]
+	let report = {
+		let rt = tokio::runtime::Builder::new_multi_thread()
+			.worker_threads(parallelism)
+			.max_blocking_threads(512 - parallelism)
+			.enable_all()
+			.build()?;
+		let report = rt.block_on(async move { tokio::spawn(run(args)).await })?;
+		rt.shutdown_timeout(Duration::from_secs(30));
+		report?
+	};
+	println!("{}", serde_json::to_string(&report)?);
+	Ok(())
+}
